function oversignsSizeVisualizer(helper, data) {
    return {
        drawField: function(parentDiv) {

            var wrapper = $('<div class="os-size-visualizer"></div>')
                .appendTo(parentDiv);

            var title = $('<div class="os-size-title">Finished Size Preview</div>')
                .appendTo(wrapper);

            var subtitle = $(
                '<div class="os-size-subtitle">' +
                'Enter your width and height to preview the finished proportions.' +
                '</div>'
            ).appendTo(wrapper);

            var stage = $('<div class="os-size-stage"></div>')
                .appendTo(wrapper);

            var shape = $('<div class="os-size-shape"></div>')
                .appendTo(stage);

            var widthLabel = $('<div class="os-width-label">12"</div>')
                .appendTo(shape);

            var heightLabel = $('<div class="os-height-label">12"</div>')
                .appendTo(shape);

            var productLabel = $('<div class="os-product-label"></div>')
                .appendTo(shape);

            var readout = $('<div class="os-size-readout"></div>')
                .appendTo(wrapper);

            productLabel.text(
                data.product || 'Product'
            );

            function cleanNumber(value) {
                var number = parseFloat(value);

                if (!isFinite(number) || number <= 0) {
                    return 1;
                }

                return number;
            }

            function formatNumber(value) {
                if (Math.round(value) === value) {
                    return value;
                }

                return parseFloat(value.toFixed(2));
            }

            function recalc() {

                var width = cleanNumber(
                    helper.get_form_value('width_inches')
                );

                var height = cleanNumber(
                    helper.get_form_value('height_inches')
                );

                var displayWidth = formatNumber(width);
                var displayHeight = formatNumber(height);

                widthLabel.text(displayWidth + '"');
                heightLabel.text(displayHeight + '"');

                readout.text(
                    'Finished Size: ' +
                    displayWidth +
                    '" × ' +
                    displayHeight +
                    '"'
                );

                var maxWidth = 300;
                var maxHeight = 175;
                var minSize = 55;

                var ratio = width / height;

                var visualWidth;
                var visualHeight;

                if (ratio >= 1) {

                    visualWidth = maxWidth;
                    visualHeight = maxWidth / ratio;

                } else {

                    visualHeight = maxHeight;
                    visualWidth = maxHeight * ratio;

                }

                visualWidth = Math.max(
                    minSize,
                    visualWidth
                );

                visualHeight = Math.max(
                    minSize,
                    visualHeight
                );

                shape.css({
                    width: visualWidth + 'px',
                    height: visualHeight + 'px'
                });
            }

            $('[name="width_inches"], [name="height_inches"]')
                .on('input change', recalc);

            recalc();
        }
    };
}
